<pdd-reason>Pure presentational React component that gates UI fragments behind a feature flag's enabled state.</pdd-reason>

<pdd-interface>
{
  "type": "frontend",
  "frontend": {
    "pages": [
      {"name": "FlagToggle", "route": "frontend/components/FlagToggle.tsx"}
    ]
